# Derived graph artifacts (per-profile under data/<profile>/): nodes, edges,
# build-stats, extraction-catalog, interpretive aggregate/notes, candidate inbox.
# All reconstructable from committed inputs on a bare clone, so ignore the tree.
data/

# Node
node_modules/
npm-debug.log*

# Editor / OS
.DS_Store
*.swp

# Extracted source text for the neuro profile — regenerate with `make refs`; the
# committed PDFs are the source of truth. Scoped to profiles/neuro deliberately:
# profiles/software-docs/refs/*.txt are upstream TEST FIXTURES and must be
# committed, or the triage suite fails on a clean checkout.
profiles/neuro/refs/*.txt
